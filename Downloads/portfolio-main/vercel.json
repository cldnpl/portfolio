{
  "framework": null,
  "installCommand": "cd nuovoportfolio && npm ci",
  "buildCommand": "cd nuovoportfolio && npm run build",
  "outputDirectory": "nuovoportfolio/out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(favicon.ico|favicon.svg|favicon.png|favicon-64.png|icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/projects", "destination": "/#projects", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true }
  ]
}
